# Copy to `.env` (git-ignored) and fill in. NEVER commit real keys.
# Everything here is optional: with no keys, nothing is sent anywhere.

# Langfuse (observability). Create a project in Langfuse Cloud or in your self-hosted instance, then copy its keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region URL: EU https://cloud.langfuse.com | US https://us.cloud.langfuse.com | Japan https://jp.cloud.langfuse.com
# (LANGFUSE_HOST still works but is deprecated.) It must match the region where you created the project.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Label the environment so demo recordings are easy to filter: development | test | video
LANGFUSE_TRACING_ENVIRONMENT=development
# Version label on every trace (default: agent-tool-call-guard@<installed version>); set it to a git SHA to compare runs
# LANGFUSE_RELEASE=
# Set to false to switch the export off without removing the keys
# LANGFUSE_TRACING_ENABLED=false

# Local hash-chained sidecar trace (always available, independent of Langfuse)
# GUARD_TRACE_DIR=./trace
